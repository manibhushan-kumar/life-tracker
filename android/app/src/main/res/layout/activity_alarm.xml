<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm_screen"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Top App Badge -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_notification" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="LIFE TRACKER ALARM"
            android:textColor="#818CF8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Alarm Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/llButtons"
        android:layout_below="@+id/llHeader"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Time Display -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAlarmTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:text="07:00"
                android:textColor="#FFFFFF"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlarmAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="AM"
                android:textColor="#94A3B8"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Live Date Display -->
        <TextView
            android:id="@+id/tvAlarmDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sunday, October 11"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Pulsing Alarm Bell Icon Circle -->
        <FrameLayout
            android:id="@+id/flIconContainer"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_alarm_icon_circle">

            <ImageView
                android:id="@+id/ivAlarmIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notification" />
        </FrameLayout>

        <!-- Alarm Title -->
        <TextView
            android:id="@+id/tvAlarmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:gravity="center"
            android:text="Reminder Alert"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Alarm Note / Body -->
        <TextView
            android:id="@+id/tvAlarmNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="Tap dismiss or snooze"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Repeat Interval Badge -->
        <TextView
            android:id="@+id/tvAlarmRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E1B4B"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="One-time Alarm"
            android:textColor="#A5B4FC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Actions: Snooze & Dismiss -->
    <LinearLayout
        android:id="@+id/llButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSnooze"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_snooze_btn"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:text="💤 SNOOZE"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_dismiss_btn"
            android:elevation="6dp"
            android:stateListAnimator="@null"
            android:text="⏰ DISMISS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_pause_btn"
            android:elevation="5dp"
            android:stateListAnimator="@null"
            android:text="⏸ PAUSE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
