# ==============================================================================
# Life Tracker - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
package-lock.json.backup
.pnpm-store/

# ------------------------------------------------------------------------------
# Web Build Outputs & Caches
# ------------------------------------------------------------------------------
dist/
build/
.cache/
.parcel-cache/

# ------------------------------------------------------------------------------
# Android Build Outputs & Caches
# ------------------------------------------------------------------------------
.gradle/
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/.kotlin/
android/.cxx/
android/.externalNativeBuild/
android/captures/
android/.navigation/

# Android build binaries & packages
*.apk
*.aab
*.idsig
*.aar
*.ap_
*.dex
*.class
*.hprof

# Gradle wrapper binary jar (auto-downloaded via ./manage.sh setup)
android/gradle/wrapper/gradle-wrapper.jar
gradle/wrapper/gradle-wrapper.jar

# Machine-specific SDK & local properties (auto-configured on setup)
local.properties
android/local.properties

# Generated Capacitor Android assets & configs (auto-regenerated on npm run cap:sync / setup)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/

